{
  "name": "server",
  "version": "1.0.0",
  "description": "Server and client app",
  "main": "server.js",
  "scripts": {
    "server": "nodemon server.js",
    "client": "npm run dev --prefix ../client",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "production": "pm2 start ecosystem.config.js --env production && pm2 log",
    "stop": "pm2 delete my-server"
  },
  "author": "Ivan",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.6",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9"
  }
}
